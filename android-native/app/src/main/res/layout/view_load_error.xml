<?xml version="1.0" encoding="utf-8"?>
<!-- Natívna obrazovka pri zlyhaní načítania hlavnej stránky (bez siete, server
     5xx). Prekrýva WebView, takže používateľ nevidí surovú chybovú stránku
     Cloudflare/Chromu. Ekvivalent iOS ErrorView v ContentView.swift. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/load_error_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_error_icon"
            android:textSize="48sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/load_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_error_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/load_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/load_error_message_server"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/load_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="200dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_load_error_button"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/load_error_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</FrameLayout>
